{
  "openapi": "3.1.0",
  "info": {
    "title": "Accord Trace API",
    "version": "0.2.1",
    "description": "Tamper-evident cryptographic evidence and verification infrastructure for AI agents. Accord Trace records integrity evidence and service timestamps; it does not establish truth, identity, authority, authorship, or legal validity."
  },
  "servers": [{ "url": "https://accordtrace.notary-labs.workers.dev" }],
  "paths": {
    "/health": {
      "get": { "operationId": "health", "responses": { "200": { "description": "Service is healthy" } } }
    },
    "/v1/capabilities": {
      "get": { "operationId": "getCapabilities", "responses": { "200": { "description": "Machine-readable capabilities, cryptography, limits and discovery endpoints" } } }
    },
    "/v1/verify": {
      "post": {
        "operationId": "verifyEnvelope",
        "responses": {
          "200": { "description": "Evidence is valid" },
          "422": { "description": "Evidence failed one or more verification checks" }
        }
      }
    },
    "/v1/receipts/{id}": {
      "get": {
        "operationId": "getReceipt",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Stored receipt" }, "404": { "description": "Receipt not found" } }
      }
    },
    "/v1/receipts/verify": {
      "post": {
        "operationId": "verifyReceipt",
        "responses": { "200": { "description": "Receipt is valid" }, "422": { "description": "Receipt verification failed" } }
      }
    },
    "/v1/notary-key": {
      "get": { "operationId": "getNotaryKey", "responses": { "200": { "description": "Accord Trace Ed25519 public key" } } }
    },
    "/v1/stats": {
      "get": { "operationId": "getLegacyPublicStats", "deprecated": true, "responses": { "200": { "description": "Legacy anonymous aggregate Accord Trace activity for the last 30 days" } } }
    },
    "/api/v1/stats": {
      "get": {
        "operationId": "getUsageStats",
        "summary": "Get privacy-safe external usage statistics",
        "description": "Returns a rolling 30-day aggregate of external Accord Trace API activity. Unique-agent figures count only explicit client/agent identifiers and store those identifiers only as SHA-256 hashes. Health checks, discovery probes and marked internal smoke tests are excluded. Historical activity before telemetry deployment is not fabricated.",
        "responses": {
          "200": {
            "description": "External usage, protocol adoption and active-agent metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "windowDays": { "type": "integer", "example": 30 },
                    "totals": { "type": "object", "additionalProperties": { "type": "integer" } },
                    "agents": {
                      "type": "object",
                      "properties": {
                        "active": {
                          "type": "object",
                          "properties": {
                            "active24h": { "type": "integer" },
                            "active7d": { "type": "integer" },
                            "active30d": { "type": "integer" }
                          }
                        },
                        "requests": {
                          "type": "object",
                          "properties": {
                            "identified": { "type": "integer" },
                            "anonymous": { "type": "integer" }
                          }
                        },
                        "protocols": { "type": "object", "additionalProperties": { "type": "integer" } }
                      }
                    },
                    "daily": { "type": "array", "items": { "type": "object" } },
                    "privacy": { "type": "string" },
                    "startedFrom": { "type": "string" }
                  }
                }
              }
            }
          },
          "503": { "description": "Usage statistics storage is not configured or temporarily unavailable" }
        }
      }
    },
    "/.well-known/agent-card.json": {
      "get": { "operationId": "getA2AAgentCard", "responses": { "200": { "description": "A2A agent card" } } }
    },
    "/a2a": {
      "get": { "operationId": "getA2AStatus", "responses": { "200": { "description": "JSON-RPC/A2A endpoint discovery status" } } },
      "post": { "operationId": "sendA2AMessage", "responses": { "200": { "description": "JSON-RPC 2.0 A2A response" } } }
    }
  }
}
