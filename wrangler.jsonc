{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notary-protocol",
  "main": "cloudflare/src/worker-v2.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pilot/*",
      "/agents/*",
      "/badges/*",
      "/api/v1/marketplace/*",
      "/api/v1/security/*",
      "/api/v1/trust/*",
      "/api/v1/gateway/*",
      "/api/v1/payments/*",
      "/api/v1/identity/*",
      "/api/v1/validation/*",
      "/api/v1/reputation/*",
      "/api/v1/attestors/*",
      "/api/v1/control-plane/*",
      "/api/v1/continuity/*",
      "/api/v1/network/*",
      "/api/v1/passport-product/*",
      "/api/v1/launch/*",
      "/api/v1/developer/*",
      "/api/v1/proofs*",
      "/api/v1/hash",
      "/api/v1/verify",
      "/",
      "/health",
      "/v1/*",
      "/a2a",
      "/mcp",
      "/openapi.json",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notary-protocol",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "STRIPE_PRICE_AGENT_PASSPORT": "price_1UC8x6L1V4ptaCD2i8kiwoPF",
    "PUBLIC_BASE_URL": "https://accordtrace.notary-labs.workers.dev",
    "PASSPORT_PRODUCT_PRICE_ATOMIC": "200",
    "PASSPORT_PRODUCT_CURRENCY": "usd",
    "AFFILIATE_PASSPORT_PRICE_ATOMIC": "200",
    "AFFILIATE_CURRENCY": "usd",
    "PASSPORT_USE_PROOF_SIGNER": "true",
    "PASSPORT_CHECKOUT_ENABLED": "false"
  },
  "observability": {"enabled": true}
}
