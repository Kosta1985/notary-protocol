{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notary-protocol",
  "main": "cloudflare/src/worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/pilot/*",
      "/agents/*",
      "/badges/*",
      "/api/v1/marketplace/*",
      "/api/v1/security/*",
      "/api/v1/trust/*",
      "/api/v1/gateway/*",
      "/api/v1/payments/*",
      "/api/v1/identity/*",
      "/api/v1/validation/*",
      "/api/v1/reputation/*",
      "/api/v1/attestors/*",
      "/api/v1/control-plane/*",
      "/api/v1/continuity/*",
      "/api/v1/network/*",
      "/api/v1/passport-product/*",
      "/api/v1/launch/*",
      "/api/v1/developer/*",
      "/",
      "/health",
      "/v1/*",
      "/a2a",
      "/openapi.json",
      "/.well-known/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notary-protocol",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "observability": {"enabled": true}
}
