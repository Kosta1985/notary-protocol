{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshhire",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/a2a", "/.well-known/*", "/openapi.json", "/llms.txt"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "meshhire",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ACCORDTRACE_BASE_URL": "https://accordtrace.notary-labs.workers.dev"
  }
}
