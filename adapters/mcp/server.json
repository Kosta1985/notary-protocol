{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.kosta1985/notary-protocol",
  "title": "Notary Protocol",
  "description": "Verify signed DealEnvelopes and retrieve portable NotaryReceipts.",
  "repository": {
    "url": "https://github.com/Kosta1985/notary-protocol",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@kosta1985/notary-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "NOTARY_URL",
          "description": "Notary Protocol API base URL.",
          "format": "string",
          "isRequired": false,
          "isSecret": false,
          "default": "https://notary-protocol.notary-labs.workers.dev"
        }
      ]
    }
  ]
}
