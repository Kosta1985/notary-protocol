WALLET_CHAIN_ID=0
TEST_WALLET_INITIAL_USDC_ATOMIC=10000000
FEATURE_AGENT_WALLETS=false
FEATURE_AGENT_PAYMENTS=false
FEATURE_AGENT_TREASURY=false
FEATURE_ECONOMIC_TRUST=false
FEATURE_GUARDIAN_CONTROLS=false
