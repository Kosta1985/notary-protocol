{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notaryprotocol.dev/schemas/notary-receipt-0.1.json",
  "title": "NotaryReceipt",
  "type": "object",
  "required": ["version", "id", "dealId", "evidenceDigest", "verifiedAt", "valid", "checks", "violations", "notary"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "0.1" },
    "id": { "type": "string" },
    "dealId": { "type": "string" },
    "evidenceDigest": { "type": "string" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "valid": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "passed"],
        "properties": {
          "code": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      }
    },
    "violations": { "type": "array", "items": { "type": "string" } },
    "notary": {
      "type": "object",
      "required": ["algorithm", "publicKey", "signature"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKey": { "type": "string" },
        "signature": { "type": "string" }
      }
    }
  }
}
