{
  "name": "@notary-protocol/sdk",
  "version": "0.1.0",
  "description": "TypeScript client and protocol helpers for Notary Protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./trust": {
      "types": "./src/trust.ts",
      "import": "./dist/trust.js"
    },
    "./gateway": {
      "types": "./src/gateway.ts",
      "import": "./dist/gateway.js"
    },
    "./payments": {
      "types": "./src/payments.ts",
      "import": "./dist/payments.js"
    }
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
